{
  "name": "dsh-cyrene-chat",
  "version": "0.2.1",
  "description": "DeepSeek Harness 插件：增加「纯文本对话模式」agent 预设——整份替换系统提示词进行纯角色对话，并附带长期记忆（remember / forget）与可配置称呼；联网搜索保留，表情包需另装 dsh-meme。随包人设文本整理自开源项目 Cyrene-Agent（MIT）。",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": "Cyrene-xl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyrene-xl/dsh-cyrene-chat.git"
  },
  "bugs": {
    "url": "https://github.com/Cyrene-xl/dsh-cyrene-chat/issues"
  },
  "homepage": "https://github.com/Cyrene-xl/dsh-cyrene-chat#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "dsh",
    "agent-preset",
    "persona",
    "chat"
  ],
  "files": [
    "index.js",
    "memory.js",
    "nickname.js",
    "cordis.patch.yml",
    "plugin.json",
    "dsh.plugin.json",
    "preset/",
    "scripts/",
    "docs/",
    "README.md",
    "LICENSES/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./index.js",
    "./memory": "./memory.js",
    "./nickname": "./nickname.js",
    "./plugin.json": "./plugin.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "id": "dsh-cyrene-chat",
    "name": "纯文本对话模式",
    "displayName": "纯文本对话模式",
    "version": "0.2.1",
    "repo": "Cyrene-xl/dsh-cyrene-chat",
    "permissions": "不在运行时申请任何权限",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "harness:check": "node --check index.js",
    "install:preset": "node scripts/install.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
